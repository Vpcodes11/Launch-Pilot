# ==============================================================================
# LaunchPilot Environment Configuration (.env.example)
# Copy this file to .env.local and fill in your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APP CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. SUPABASE (Postgres Database, Auth, Storage)
# Get these from: Supabase Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 3. LLM API (OpenAI or Anthropic for analysis and tailored copy generation)
# Provide either OpenAI or Anthropic (or both). If omitted in local dev,
# LaunchPilot's built-in intelligent indie-hacker heuristic engine will activate.
# ------------------------------------------------------------------------------
OPENAI_API_KEY="sk-proj-..."
ANTHROPIC_API_KEY="sk-ant-..."

# ------------------------------------------------------------------------------
# 4. PAYMENTS - STRIPE (USD Payments)
# Get these from: Stripe Dashboard -> Developers -> API Keys / Webhooks
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ------------------------------------------------------------------------------
# 5. PAYMENTS - RAZORPAY (INR Payments)
# Get these from: Razorpay Dashboard -> Settings -> API Keys / Webhooks
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_razorpay_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAILS - RESEND
# Get these from: Resend Dashboard -> API Keys
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_..."
EMAIL_FROM="LaunchPilot <notifications@launchpilot.dev>"
